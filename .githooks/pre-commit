#!/usr/bin/env bash
#
# Pre-commit hook: reject the commit when the workspace isn't
# `cargo fmt`-clean, mirroring what CI's `cargo fmt --all --check`
# does. Runs when there's at least one staged Rust file — no cost
# on doc / config-only commits.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# (the hook is committed, so every contributor gets it after that)
#
# Why "check the whole workspace" instead of "format only staged
# files":
#   1. Matches CI 1:1 — if this hook is green, the CI fmt gate is
#      guaranteed green. No skew.
#   2. Catches drift outside the diff. `cargo fmt` normalizes the
#      *file*, not "the changed lines", so a staged edit next to an
#      already-unformatted region would land a commit that CI
#      rejects — exactly the failure mode this hook is meant to
#      prevent.
#   3. Sidesteps the Windows PATH split. Git for Windows launches
#      hooks through msys bash whose `$PATH` doesn't include rustup's
#      shim directory. `command -v rustfmt` therefore fails and the
#      previous hook version silently skipped ("rustfmt not found").
#      Calling `cargo fmt` reaches rustfmt through cargo's own
#      shim, which msys bash finds because Git for Windows inherits
#      Windows `%PATH%` — where `~/.cargo/bin/cargo.exe` lives.
#
# Skip with `git commit --no-verify` when you genuinely need to
# commit unformatted code (e.g. a WIP snapshot pushed to a branch).

set -euo pipefail

# Only run when the commit actually touches Rust. --diff-filter=d
# drops deletions (they can't be unformatted).
if ! git diff --cached --name-only --diff-filter=d -- '*.rs' | grep -q .; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    # No cargo means no rustfmt either. Warn instead of blocking so
    # someone editing a doc string on a machine without a toolchain
    # can still commit.
    echo "pre-commit: cargo not on PATH — skipping fmt check (install via https://rustup.rs)" >&2
    exit 0
fi

# `--all` covers every workspace member; `-- --check` makes rustfmt
# report diffs and exit non-zero instead of rewriting files. Output
# goes straight to the user so they see the exact hunks CI would
# flag.
if ! cargo fmt --all -- --check; then
    echo "" >&2
    echo "pre-commit: workspace is not fmt-clean. Run 'cargo fmt --all' and re-commit." >&2
    echo "            (or 'git commit --no-verify' to bypass.)" >&2
    exit 1
fi

exit 0
